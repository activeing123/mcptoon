{
  "name": "gitlab",
  "display_name": "GitLab",
  "description": "Full GitLab API — projects, issues, MRs, pipelines, code search",
  "package": "@modelcontextprotocol/server-gitlab",
  "install": "npx -y @modelcontextprotocol/server-gitlab",
  "config": {
    "transport": "stdio",
    "command": ["npx", "-y"],
    "args": ["@modelcontextprotocol/server-gitlab"],
    "env": {
      "GITLAB_PERSONAL_ACCESS_TOKEN": "<your-gitlab-pat>",
      "GITLAB_API_URL": "https://gitlab.com/api/v4"
    }
  },
  "tools": ["create_issue", "get_issue", "list_issues", "update_issue", "create_merge_request", "get_merge_request", "list_merge_requests", "search_projects", "get_project", "list_pipelines", "get_pipeline", "create_pipeline", "get_file_contents", "search_code"],
  "tool_count": 14,
  "verified": true,
  "verified_date": "2026-08-12",
  "platforms": { "windows": "ok", "macos": "ok", "linux": "ok" },
  "pitfalls": [
    "Requires GitLab Personal Access Token with api scope",
    "Set GITLAB_API_URL for self-hosted instances (default: gitlab.com)",
    "Rate limit: 2000 requests/min per token"
  ],
  "notes": "Complete GitLab integration. Create token at https://gitlab.com/-/user_settings/personal_access_tokens",
  "usage": "mcptoon add gitlab --stdio npx -y @modelcontextprotocol/server-gitlab",
  "our_usage_rank": null,
  "our_usage_calls": 0,
  "beginner_friendly": false,
  "security": {
    "audited": true,
    "audited_date": "2026-08-12",
    "credential_safe": true,
    "env_vars_required": [
      {"name": "GITLAB_PERSONAL_ACCESS_TOKEN", "sensitivity": "high", "description": "GitLab PAT with api scope"},
      {"name": "GITLAB_API_URL", "sensitivity": "low", "description": "GitLab API base URL (self-hosted override)"}
    ],
    "permissions": ["read: projects, issues, MRs, pipelines, code", "write: issues, MRs, pipelines"]
  },
  "bundled": false,
  "install_method": "on-demand",
  "install_size": "~5MB"
}
