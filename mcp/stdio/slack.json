{
  "name": "slack",
  "display_name": "Slack",
  "description": "Send messages, list channels, get history — team communication automation",
  "package": "@modelcontextprotocol/server-slack",
  "install": "npx -y @modelcontextprotocol/server-slack",
  "config": {
    "transport": "stdio",
    "command": ["npx", "-y"],
    "args": ["@modelcontextprotocol/server-slack"],
    "env": {
      "SLACK_BOT_TOKEN": "<your-slack-bot-token>",
      "SLACK_TEAM_ID": "<your-slack-team-id>"
    }
  },
  "tools": ["slack_list_channels", "slack_post_message", "slack_get_channel_history", "slack_reply_thread", "slack_get_users"],
  "tool_count": 5,
  "verified": true,
  "verified_date": "2026-08-12",
  "platforms": { "windows": "ok", "macos": "ok", "linux": "ok" },
  "pitfalls": [
    "Requires Slack Bot Token (xoxb-) and Team ID",
    "Bot must be invited to channels before it can read/post",
    "Rate limit: 1 message/sec per channel"
  ],
  "notes": "Automate Slack workflows from your AI agent. Create token at https://api.slack.com/tutorials/tracking/getting-started",
  "usage": "mcptoon add slack --stdio npx -y @modelcontextprotocol/server-slack",
  "our_usage_rank": null,
  "our_usage_calls": 0,
  "beginner_friendly": false,
  "security": {
    "audited": true,
    "audited_date": "2026-08-12",
    "credential_safe": true,
    "env_vars_required": [
      {"name": "SLACK_BOT_TOKEN", "sensitivity": "high", "description": "Slack Bot OAuth Token (xoxb-)"},
      {"name": "SLACK_TEAM_ID", "sensitivity": "medium", "description": "Slack Workspace Team ID"}
    ],
    "permissions": ["read: channels, messages, users", "write: post messages, thread replies"]
  },
  "bundled": false,
  "install_method": "on-demand",
  "install_size": "~5MB"
}
