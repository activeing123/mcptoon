{
  "name": "sqlite",
  "display_name": "SQLite",
  "description": "Query and manage SQLite databases — schema inspection, read queries, and write operations",
  "package": "@modelcontextprotocol/server-sqlite",
  "install": "npx -y @modelcontextprotocol/server-sqlite --db-path /path/to/your.db",
  "config": {
    "transport": "stdio",
    "command": [
      "npx",
      "-y"
    ],
    "args": [
      "@modelcontextprotocol/server-sqlite",
      "--db-path",
      "/path/to/your.db"
    ],
    "env": {}
  },
  "tools": [
    "read_query",
    "write_query",
    "list_tables",
    "describe_table",
    "append_data"
  ],
  "tool_count": 5,
  "verified": true,
  "verified_date": "2026-08-11",
  "platforms": {
    "windows": "ok",
    "macos": "ok",
    "linux": "ok"
  },
  "pitfalls": [
    "Must pass --db-path argument pointing to your .db file",
    "Write operations (write_query, append_data) execute without confirmation — be careful",
    "No transaction support — each query is auto-committed"
  ],
  "notes": "Great for data analysis tasks. The AI can list tables, inspect schema, and run SQL queries. Create a .db file first: sqlite3 test.db",
  "usage": "mcptoon add sqlite --stdio npx -y @modelcontextprotocol/server-sqlite --db-path /path/to/your.db",
  "our_usage_rank": null,
  "our_usage_calls": 0,
  "beginner_friendly": true,
  "security": {
    "audited": true,
    "audited_date": "2026-08-12",
    "credential_safe": true,
    "env_vars_required": [],
    "permissions": [
      "read: tables, schema, rows",
      "write: INSERT/UPDATE/DELETE (if allowed)"
    ]
  },
  "bundled": false,
  "install_method": "on-demand"
}