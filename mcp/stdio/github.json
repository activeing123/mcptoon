{
  "name": "github",
  "display_name": "GitHub",
  "description": "Full GitHub API — repos, issues, PRs, code search, commits",
  "package": "@modelcontextprotocol/server-github",
  "install": "npx -y @modelcontextprotocol/server-github",
  "config": {
    "transport": "stdio",
    "command": [
      "npx",
      "-y"
    ],
    "args": [
      "@modelcontextprotocol/server-github"
    ],
    "env": {
      "GITHUB_PERSONAL_ACCESS_TOKEN": "<your-github-pat>"
    }
  },
  "tools": [
    "add_issue_comment",
    "create_branch",
    "create_issue",
    "create_pull_request",
    "create_pull_request_review",
    "create_repository",
    "fork_repository",
    "get_file_contents",
    "get_issue",
    "get_pull_request",
    "get_pull_request_comments",
    "get_pull_request_files",
    "get_pull_request_reviews",
    "get_pull_request_status",
    "list_commits",
    "list_issues",
    "list_pull_requests",
    "merge_pull_request",
    "push_files",
    "search_code",
    "search_issues",
    "search_repositories",
    "search_users",
    "update_issue",
    "update_pull_request_branch"
  ],
  "tool_count": 26,
  "verified": true,
  "verified_date": "2026-08-11",
  "platforms": {
    "windows": "ok",
    "macos": "ok",
    "linux": "ok"
  },
  "pitfalls": [
    "Requires GitHub Personal Access Token (PAT) with repo scope",
    "API rate limit: 5000 requests/hour per token",
    "push_files uses base64 content — large files may hit limits"
  ],
  "notes": "Create your PAT at https://github.com/settings/tokens — fine-grained tokens also work.",
  "usage": "mcptoon add github --stdio npx -y @modelcontextprotocol/server-github",
  "our_usage_rank": 2,
  "our_usage_calls": 714,
  "security": {
    "audited": true,
    "audited_date": "2026-08-12",
    "credential_safe": true,
    "env_vars_required": [
      {
        "name": "GITHUB_PERSONAL_ACCESS_TOKEN",
        "sensitivity": "high",
        "description": "GitHub PAT with repo scope"
      }
    ],
    "permissions": [
      "read: repos, issues, PRs, code",
      "write: issues, PRs, commits, repos"
    ]
  },
  "bundled": false,
  "install_method": "on-demand"
