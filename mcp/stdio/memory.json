{
  "name": "memory",
  "display_name": "Memory",
  "description": "Persistent knowledge graph — store entities, relations, and observations for your AI agent",
  "package": "@modelcontextprotocol/server-memory",
  "install": "npx -y @modelcontextprotocol/server-memory",
  "config": {
    "transport": "stdio",
    "command": [
      "npx",
      "-y"
    ],
    "args": [
      "@modelcontextprotocol/server-memory"
    ],
    "env": {}
  },
  "tools": [
    "create_entities",
    "create_relations",
    "add_observations",
    "delete_entities",
