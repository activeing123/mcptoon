    "delete_relations",
    "read_graph",
    "search_nodes",
    "open_nodes"
  ],
  "tool_count": 9,
  "verified": true,
  "verified_date": "2026-08-11",
  "platforms": {
    "windows": "ok",
    "macos": "ok",
    "linux": "ok"
