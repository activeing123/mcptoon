{
  "name": "notion",
  "display_name": "Notion",
  "description": "Read and write Notion pages, databases — knowledge base automation",
  "package": "@modelcontextprotocol/server-notion",
  "install": "npx -y @modelcontextprotocol/server-notion",
  "config": {
    "transport": "stdio",
    "command": ["npx", "-y"],
    "args": ["@modelcontextprotocol/server-notion"],
    "env": {
      "NOTION_API_KEY": "<your-notion-integration-token>"
    }
  },
  "tools": ["notion_search", "notion_retrieve_page", "notion_retrieve_block", "notion_append_block", "notion_update_block", "notion_create_page", "notion_list_users", "notion_get_database", "notion_query_database", "notion_create_database"],
  "tool_count": 10,
  "verified": true,
  "verified_date": "2026-08-12",
  "platforms": { "windows": "ok", "macos": "ok", "linux": "ok" },
  "pitfalls": [
    "Requires Notion Integration token — create at https://www.notion.so/my-integrations",
    "Integration must be explicitly shared to pages/databases you want to access",
    "API rate limit: 3 requests/sec"
  ],
  "notes": "Full Notion API access. Search pages, query databases, create/update content. Perfect for AI agents that manage knowledge bases.",
  "usage": "mcptoon add notion --stdio npx -y @modelcontextprotocol/server-notion",
  "our_usage_rank": null,
  "our_usage_calls": 0,
  "beginner_friendly": false,
  "security": {
    "audited": true,
    "audited_date": "2026-08-12",
    "credential_safe": true,
    "env_vars_required": [
      {"name": "NOTION_API_KEY", "sensitivity": "high", "description": "Notion Integration Secret Token (secret_)"}
    ],
    "permissions": ["read: pages, databases, blocks, users", "write: create/update pages, blocks, databases"]
  },
  "bundled": false,
  "install_method": "on-demand",
  "install_size": "~5MB"
}
